<section class="services" id="services" data-scroll-section>
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-head__num">02 / What we do</span>
      <h2 class="section-head__title">
        Three divisions. <em>One ecosystem.</em>
      </h2>
      <p class="section-head__sub">
        Buy a total station from <em>Enterprises</em>. Get your team trained at the <em>Academy</em>. Subcontract your site to <em>Construction</em>. The same Leica equipment shows up everywhere.
      </p>
    </header>

    <div class="services__list">
      <% site.divisions.forEach((d, i) => { %>
      <article class="service-row <%= i % 2 === 1 ? 'service-row--reverse' : '' %>" data-reveal>
        <a class="service-row__media" href="#contact" aria-label="Get in touch about <%= d.name %>">
          <img src="<%= d.image %>" alt="<%= d.name %>" loading="lazy" />
          <span class="service-row__corner">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </span>
        </a>

        <div class="service-row__body">
          <span class="service-row__num"><%= d.num %></span>
          <span class="service-row__role"><%= d.role %></span>
          <h3 class="service-row__title"><%= d.name %></h3>
          <p class="service-row__tagline"><%= d.tagline %></p>
          <p class="service-row__copy"><%= d.copy %></p>
          <ul class="service-row__list">
            <% d.capabilities.forEach((c) => { %>
            <li><span class="dash">—</span><%= c %></li>
            <% }) %>
          </ul>
          <a class="service-row__link" href="#contact">
            <span>Talk to <%= d.name %></span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
