<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z" />
            <circle cx="16" cy="16" r="4" />
            <path d="M16 8 L16 24 M8 16 L24 16" stroke-dasharray="2 2" />
          </svg>
        </span>
        <h3 class="footer__name"><%= site.brand.name %></h3>
        <p class="footer__tag">"<%= site.brand.tagline %>"</p>
      </div>

      <div class="footer__cols">
        <div class="footer__col">
          <span class="eyebrow">Divisions</span>
          <ul>
            <li><a href="#services">Shahi Enterprises</a></li>
            <li><a href="#services">Shahi Construction</a></li>
            <li><a href="#services">Shahi Survey Academy</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <span class="eyebrow">Site</span>
          <ul>
            <li><a href="#about">About</a></li>
            <li><a href="#projects">Selected work</a></li>
            <li><a href="#stats">Numbers</a></li>
            <li><a href="#testimonials">Voices</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <span class="eyebrow">Reach us</span>
          <ul>
            <li><a href="mailto:<%= site.brand.email %>"><%= site.brand.email %></a></li>
            <% site.brand.phones.forEach((ph) => { %>
              <li><a href="tel:<%= ph.replace(/\s/g, '') %>"><%= ph %></a></li>
            <% }) %>
            <li class="footer__addr"><%= site.brand.address %></li>
          </ul>
        </div>
        <div class="footer__col">
          <span class="eyebrow">Follow</span>
          <ul class="footer__social">
            <li><a href="<%= site.brand.socials.facebook  %>" target="_blank" rel="noopener" aria-label="Facebook">FB</a></li>
            <li><a href="<%= site.brand.socials.instagram %>" target="_blank" rel="noopener" aria-label="Instagram">IG</a></li>
            <li><a href="<%= site.brand.socials.youtube   %>" target="_blank" rel="noopener" aria-label="YouTube">YT</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__wordmark" aria-hidden="true">
      <span>SHAHI</span><span class="footer__wordmark-dot">·</span><span>GROUP</span>
    </div>

    <div class="footer__bottom">
      <p>© <%= new Date().getFullYear() %> <%= site.brand.name %>. All rights reserved.</p>
      <p class="footer__regions">
        <% site.brand.regions.forEach((r, i) => { %>
          <span><%= r %></span><% if (i < site.brand.regions.length - 1) { %><span class="dot">·</span><% } %>
        <% }) %>
      </p>
    </div>
  </div>
</footer>
