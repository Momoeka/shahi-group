<section class="projects" id="projects" data-scroll-section>
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-head__num">03 / Selected work</span>
      <h2 class="section-head__title">
        Numbers <em>on the ground</em>, not on paper.
      </h2>
      <p class="section-head__sub">
        A short list. The full one would be longer than this page.
      </p>
    </header>

    <div class="projects__grid">
      <% site.projects.forEach((p, i) => { %>
      <article class="project-card" data-reveal data-stagger="<%= i %>">
        <a href="#contact" class="project-card__media" aria-label="<%= p.title %> — get in touch">
          <img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy" />
          <span class="project-card__tag"><%= p.tag %></span>
        </a>
        <div class="project-card__body">
          <div class="project-card__meta">
            <span class="project-card__location"><%= p.location %></span>
            <span class="project-card__metric"><%= p.metric %></span>
          </div>
          <h3 class="project-card__title"><%= p.title %></h3>
          <p class="project-card__copy"><%= p.copy %></p>
          <span class="project-card__cta">
            <span>Read brief</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
