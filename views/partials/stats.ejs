<section class="stats" id="stats" data-scroll-section>
  <div class="stats__contour" aria-hidden="true">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="#3D3D3D" stroke-width="0.7" opacity="0.55">
        <path d="M-50 720 Q 200 660, 420 690 T 880 700 T 1320 660 T 1680 690"/>
        <path d="M-50 660 Q 220 580, 460 620 T 920 640 T 1380 580 T 1680 610"/>
        <path d="M-50 600 Q 240 510, 500 560 T 960 580 T 1440 500 T 1680 540"/>
        <path d="M-50 540 Q 260 440, 540 500 T 1000 520 T 1500 420 T 1680 470"/>
        <path d="M-50 480 Q 280 380, 580 440 T 1040 460 T 1540 350 T 1680 400"/>
        <path d="M-50 420 Q 300 320, 620 380 T 1080 400 T 1560 290 T 1680 330"/>
        <path d="M-50 360 Q 320 270, 660 330 T 1120 340 T 1560 240 T 1680 270"/>
        <path d="M-50 300 Q 340 220, 700 280 T 1160 280 T 1540 200 T 1680 220"/>
        <path d="M-50 240 Q 360 180, 740 230 T 1200 220 T 1500 170 T 1680 180"/>
        <path d="M-50 180 Q 380 150, 780 180 T 1240 160 T 1460 140 T 1680 140"/>
        <path d="M-50 120 Q 400 110, 820 130 T 1280 100 T 1500 100 T 1680 100"/>
      </g>
      <g fill="#6B6B6B" font-family="JetBrains Mono, monospace" font-size="9" opacity="0.4">
        <text x="40"  y="555">450 m</text>
        <text x="320" y="475">500 m</text>
        <text x="640" y="395">550 m</text>
        <text x="960" y="315">600 m</text>
      </g>
    </svg>
  </div>

  <div class="container stats__inner">
    <header class="section-head section-head--center" data-reveal>
      <span class="section-head__num">04 / By the numbers</span>
      <h2 class="section-head__title">Field-tested. <em>Documented.</em></h2>
    </header>

    <div class="stats__grid">
      <% site.stats.forEach((s, i) => { %>
      <div class="stat" data-reveal data-stagger="<%= i %>">
        <span class="stat__num"
              data-counter
              data-target="<%= s.value %>"
              data-suffix="<%= s.suffix %>">0</span>
        <span class="stat__label"><%= s.label %></span>
      </div>
      <% }) %>
    </div>
  </div>
</section>
